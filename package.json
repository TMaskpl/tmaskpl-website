{
  "name": "tmaskpl-website",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 4321 --ip 127.0.0.1 --local-upstream 127.0.0.1:4321",
    "serve:reference": "http-server reference -p 4322 -s -c-1",
    "test": "node --test tests/worker.test.js && playwright test",
    "deploy": "astro build && wrangler deploy",
    "test:worker": "node --test tests/worker.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "astro": "^7.3.5",
    "http-server": "^14.1.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "wrangler": "^4.147.0"
  }
}
