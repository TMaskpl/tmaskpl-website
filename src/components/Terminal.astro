
<div class="window">
  <div class="title-bar">
    <span class="dot close"></span>
    <span class="dot min"></span>
    <span class="dot max"></span>
    <span class="bar-title">
      biuro@tmask.pl: ~
    </span>
  </div>

  <div class="terminal" id="terminal">
    <!-- output injected by JS -->
    <div class="input-row" id="input-row">
      <span class="prompt">daniel@tmask:~$&nbsp;</span>
      <input type="text" id="cmd-input" autocomplete="off" autocorrect="off" spellcheck="false" placeholder="">
