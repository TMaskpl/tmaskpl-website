    <button class="pill" data-cmd="whoami">whoami</button>
    <button class="pill" data-cmd="skills">skills</button>
    <button class="pill" data-cmd="projects">projects</button>
    <button class="pill" data-cmd="contact">contact</button>
    <button class="pill" data-cmd="social">social</button>
    <button class="pill" data-cmd="help">help</button>
    <button class="pill" data-cmd="clear">clear</button>
    <button class="pill" data-cmd="hire" data-hire>hire</button>
  </div>
</div>

