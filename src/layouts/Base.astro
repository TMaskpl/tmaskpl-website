---
import '../styles/terminal.css';
---
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daniel Niemczok — DevOps &amp; Automation Engineer | TMask.pl</title>
  <meta name="description" content="Daniel Niemczok — inżynier DevOps i automatyzacji z Polski. Specjalista Docker, Kubernetes, Ansible, Python, CI/CD i integracji AI/LLM. Dostępny do współpracy.">
  <link rel="canonical" href="https://tmask.pl/">

  <!-- Open Graph -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="Daniel Niemczok — DevOps &amp; Automation Engineer">
  <meta property="og:description" content="Inżynier z wieloletnim doświadczeniem w budowaniu niezawodnej infrastruktury i automatyzacji procesów. Docker, Kubernetes, Ansible, Python, AI/LLM.">
  <meta property="og:url" content="https://tmask.pl/">
  <meta property="og:site_name" content="TMask.pl">
  <meta property="og:locale" content="pl_PL">
  <meta property="profile:first_name" content="Daniel">
  <meta property="profile:last_name" content="Niemczok">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Daniel Niemczok — DevOps &amp; Automation Engineer">
  <meta name="twitter:description" content="Inżynier DevOps i automatyzacji. Docker, Kubernetes, Ansible, Python, CI/CD, AI/LLM. Polska.">

  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://tmask.pl/#person",
        "name": "Daniel Niemczok",
        "jobTitle": "DevOps & Automation Engineer",
        "url": "https://tmask.pl",
        "email": "biuro@tmask.pl",
        "description": "Inżynier z wieloletnim doświadczeniem w budowaniu niezawodnej infrastruktury i automatyzacji procesów. Pomaga firmom wdrażać nowoczesne rozwiązania DevOps, automatyzować powtarzalne zadania i integrować AI w codziennych procesach biznesowych.",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "PL"
        },
        "sameAs": [
          "https://www.linkedin.com/in/daniel-niemczok-1a533b2b/",
          "https://github.com/TMaskpl",
          "https://www.youtube.com/@DanielNiemczok"
        ],
        "knowsAbout": [
          "Docker", "Kubernetes", "Linux", "Bash", "Proxmox", "Nginx", "Apache", "Mikrotik",
          "Ansible", "n8n", "Terraform", "Jenkins", "CI/CD",
          "Python", "PowerShell",
          "Claude API", "LLM", "RAG", "AI Agents",
          "Prometheus", "Grafana", "ELK Stack", "DevOps", "Infrastructure Automation"
        ]
      },
      {
        "@type": "ProfilePage",
        "@id": "https://tmask.pl/#webpage",
        "url": "https://tmask.pl",
        "name": "Daniel Niemczok — DevOps & Automation Engineer | TMask.pl",
        "description": "Osobista strona portfolio Daniela Niemczoka — inżyniera DevOps i automatyzacji z Polski.",
        "inLanguage": "pl",
        "about": { "@id": "https://tmask.pl/#person" },
        "author": { "@id": "https://tmask.pl/#person" }
      }
    ]
  }
  </script>
</head>
<body>
<slot />
</body>
</html>
