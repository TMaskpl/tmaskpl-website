{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmaskpl-website",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker musi widzieć każde żądanie, żeby przekierować http/www także dla plików statycznych
    "run_worker_first": true
  },
  // Workers Builds dla gałęzi innych niż main uruchamia `wrangler preview`, który wymaga tego bloku
  "previews": {},
  "routes": [
    { "pattern": "tmask.pl", "custom_domain": true },
    { "pattern": "www.tmask.pl", "custom_domain": true }
  ]
}
